<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="one-click" name="One click">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="What one click on the mystery button does" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="From app/index.html. Colours show what you can see and what stays hidden." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="760" height="24" as="geometry" /></mxCell>
        <mxCell id="grpA" value="Part 1: the script remembers (the click handler, lines 31–36)" style="rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1000" height="820" as="geometry" /></mxCell>
        <mxCell id="grpB" value="Part 2: the script repaints the page (function w, lines 25–30)" style="rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1060" width="1000" height="990" as="geometry" /></mxCell>
        <mxCell id="start" value="You click the button" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="shrink" value="Button shrinks to 97%&#xa;while you hold it down" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="750" y="95" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="clock" value="Read the clock.&#xa;gap = time since your last click&#xa;(0 on the first click)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="grpA"><mxGeometry x="370" y="50" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="count" value="Add 1 to the click count" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="grpA"><mxGeometry x="370" y="170" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="store" value="localStorage: mb.n&#xa;(still there after a reload)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="grpA"><mxGeometry x="740" y="155" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="dfast" value="Less than 0.4 s&#xa;since the last click?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grpA"><mxGeometry x="380" y="280" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="plus" value="Fast streak + 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="grpA"><mxGeometry x="740" y="450" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="reset" value="Fast streak = 1.&#xa;If the pause was 1 s or more,&#xa;first remember the old streak" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="grpA"><mxGeometry x="40" y="440" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="dpat" value="Secret pattern done?&#xa;3 fast, pause ≥ 1 s, 2 fast" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grpA"><mxGeometry x="360" y="560" width="280" height="140" as="geometry" /></mxCell>
        <mxCell id="unlock" value="Unlock the secret" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="grpA"><mxGeometry x="740" y="730" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="hue" value="Background colour shifts a little:&#xa;hue = 210 + 3 × count" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="grpB"><mxGeometry x="370" y="50" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="d7" value="Is the count a&#xa;multiple of 7?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grpB"><mxGeometry x="380" y="170" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="star" value="Tab title becomes ✦ and&#xa;the count, e.g. “✦ 7”" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="grpB"><mxGeometry x="740" y="340" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="plain" value="Tab title set to “Click me”&#xa;(looks the same)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="grpB"><mxGeometry x="40" y="340" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="dsec" value="Secret unlocked?&#xa;(this click or earlier)" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grpB"><mxGeometry x="370" y="460" width="260" height="130" as="geometry" /></mxCell>
        <mxCell id="msg" value="Show “Mischief managed.”&#xa;under the button" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="grpB"><mxGeometry x="740" y="630" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="drev" value="Address has&#xa;?reveal in it?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grpB"><mxGeometry x="380" y="750" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="panel" value="Refresh the reveal panel&#xa;(7 hidden numbers)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="grpB"><mxGeometry x="740" y="900" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="end" value="Wait for the next click" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="400" y="2090" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="e_start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#333333;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="clock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_shrink" value="while held" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#333333;fontSize=12;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="shrink"><mxGeometry relative="1" as="geometry" /></mxCell>
