    },
    {
      "participant": "page",
      "from": 195,
      "to": 230,
      "type": "frontend"
    },
    {
      "participant": "handler",
      "from": 305,
      "to": 436,
      "type": "backend"
    },
    {
      "participant": "store",
      "from": 340,
      "to": 370,
      "type": "database"
    },
    {
      "participant": "repaint",
      "from": 425,
      "to": 800,
      "type": "backend"
    },
    {
      "participant": "page",
      "from": 555,
      "to": 856,
      "type": "frontend"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "What you can see",
      "items": [
        "The button shrinks while you hold it down",
        "The tab title changes on clicks 7, 14, 21 and so on",
        "\"Mischief managed.\" appears after the secret pattern",
        "The colour shift is real but too small to notice from one click"
      ]
    },
    {
      "dot": "violet",
      "title": "What stays hidden",
      "items": [
        "The gap between clicks, the fast streak and the secret live in the script's memory",
        "Only the count is saved, in localStorage as mb.n",
        "A reload forgets everything except the count"
      ]
    },
    {
      "dot": "amber",
      "title": "Check it yourself",
      "items": [
        "Add ?reveal to the address to see the hidden numbers",
        "DevTools > Application > Local Storage shows mb.n",
        "DevTools > Network shows nothing is sent anywhere"
      ]
    }
  ]
}
